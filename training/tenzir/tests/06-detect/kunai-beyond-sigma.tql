// Sigma's Linux catalog covers process creation, network connections, and file
// creation. Kunai also reports kernel module loads, executable memory, and
// debugger attachment, which the catalog does not model yet. Plain TQL fills
// that gap: a `match` statement routes each event by its OCSF class, and every
// arm names the behavior it finds.
//
// Docs:
//   https://tenzir.com/docs/guides/detect/match-events-with-tql
//   https://tenzir.com/docs/guides/detect/model-detections-in-ocsf
//   https://tenzir.com/docs/reference/statements#match
let $data = env("TENZIR_INPUTS").otherwise("data")
from_file f"{$data}/kunai/dropper.jsonl" {
  read_ndjson
}
kunai::ocsf::normalize
ocsf_derive
let $audit = ["auditd", "rsyslogd", "systemd-journald"]
match class_name {
  "Kernel Extension Activity" => {
    finding = "A kernel module loads"
  }
  "Memory Activity" => {
    finding = "A process makes its memory executable"
  }
  "Process Activity" if activity_name == "Open" => {
    finding = "A process attaches to another process"
  }
  "Process Activity" if activity_name == "Terminate" and process.name in $audit => {
    finding = "A process kills a logging daemon"
  }
  // A match needs an arm for every event. Everything else is no finding.
  _ => {
    discard
  }
}
sort time
