// Flags Kunai activity that matches a MISP indicator. The match carries the
// MISP context, so analysts see why the event matters.
//
// Docs:
//   https://tenzir.com/docs/reference/operators/context_enrich
//   https://tenzir.com/docs/guides/enrich/enrich-with-threat-intel
//   https://tenzir.com/docs/reference/functions/where
let $data = env("TENZIR_INPUTS").otherwise("data")
from_file f"{$data}/kunai/dropper.jsonl" {
  read_ndjson
}
kunai::ocsf::normalize
ocsf_derive
ocsf_cast
// Pull out the fields that can match: the destination, and the SHA-256 of
// the executable.
dst_ip = dst_endpoint?.ip?
dst_host = dst_endpoint?.hostname?
sha256 = process?.file?.hashes?.where(h => h.algorithm_id == 3)[0]?.value?
context_enrich "misp_iocs", key=dst_ip, into=hit_ip
context_enrich "misp_iocs", key=dst_host, into=hit_host
context_enrich "misp_iocs", key=sha256, into=hit_hash
context_enrich "misp_ioc_filter", key=dst_ip, into=seen_ip
where hit_ip != null or hit_host != null or hit_hash != null
select time, class_name, process=process?.name?.otherwise(actor.process?.name?), dst_ip, dst_host, sha256,
       ioc=hit_ip.otherwise(hit_host).otherwise(hit_hash)
sort time
